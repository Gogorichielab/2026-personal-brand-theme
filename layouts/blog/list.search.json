{{- $posts := slice -}}
{{- range .RegularPagesRecursive -}}
	{{- $tags := .Params.tags | default slice -}}
	{{- $posts = $posts | append (dict
		"title" .Title
		"url" .RelPermalink
		"date" (time.Format ":date_medium" .Date)
		"summary" (.Summary | plainify | htmlUnescape | truncate 170)
		"tags" $tags
		"text" (.Plain | htmlUnescape)
	) -}}
{{- end -}}
{{- $posts | jsonify -}}
